{
  "name": "parallax-bleed",
  "displayName": "Parallax Bleed",
  "description": "4 full-bleed image sections stacked sequentially with deep internal parallax bounds, virtual camera momentum, and weighted layer micro-latency.",
  "category": "scroll",
  "tags": ["GSAP", "Parallax", "Full Bleed", "Cinematic", "Physics"],
  "author": "vessel",
  "controls": [
    {
      "name": "parallaxIntensity",
      "label": "Parallax Intensity",
      "type": "slider",
      "defaultValue": 45,
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%"
    },
    {
      "name": "scrollSpeed",
      "label": "Scroll Speed",
      "type": "slider",
      "defaultValue": 1.0,
      "min": 0.2,
      "max": 3.0,
      "step": 0.1,
      "unit": "x"
    },
    {
      "name": "blurVariant",
      "label": "Edge Falloff",
      "type": "select",
      "defaultValue": "pure",
      "options": [
        { "label": "Pure Blur", "value": "pure" },
        { "label": "Refractive Glass", "value": "refractive" },
        { "label": "Liquid Caustic", "value": "liquid" },
        { "label": "Line Glass (CRT)", "value": "crt" },
        { "label": "Thermal Haze", "value": "thermal" }
      ]
    }
  ]
}
