{
  "id": "apparatus-cinematic-unstack",
  "name": "Cinematic Unstacking Sequence",
  "category": "scroll",
  "description": "High-impact card stack unstacking sequence with 7 kinetic motion variants, internal image camera parallax, physical parabolic card bend curve, pitch exit tilt, and multi-axis kinetic lag.",
  "controls": [
    {
      "name": "variant",
      "label": "Kinetic Motion Variant",
      "type": "select",
      "defaultValue": "cinematic-unstack",
      "options": [
        { "label": "CINEMATIC UNSTACK (Parallax Lift)", "value": "cinematic-unstack" },
        { "label": "HELICAL FAN (3D Spiral Spin)", "value": "helical-fan" },
        { "label": "HYPER ORIGAMI (3D Unfold & Surge)", "value": "hyper-origami" },
        { "label": "VESSEL CURTAIN (Theatrical Pitch Roll)", "value": "vessel-curtain" },
        { "label": "PRISM SHUTTER (3D Shear Slide)", "value": "prism-shutter" },
        { "label": "QUANTUM WARP (Gravitational Wormhole)", "value": "quantum-warp" },
        { "label": "VORTEX PEEL (Helical Spin Dive)", "value": "vortex-peel" }
      ]
    },
    {
      "name": "cardCount",
      "label": "Stack Depth",
      "type": "slider",
      "defaultValue": 6,
      "min": 3,
      "max": 12,
      "step": 1
    },
    {
      "name": "parallaxIntensity",
      "label": "Internal Image Parallax",
      "type": "slider",
      "defaultValue": 35,
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%"
    },
    {
      "name": "cardBendAmount",
      "label": "Velocity Card Bend Arc",
      "type": "slider",
      "defaultValue": 35,
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px"
    },
    {
      "name": "tiltAngle",
      "label": "Backward Pitch Angle",
      "type": "slider",
      "defaultValue": 10,
      "min": 0,
      "max": 45,
      "step": 1,
      "unit": "°"
    },
    {
      "name": "scrollSensitivity",
      "label": "Scroll Travel Pace",
      "type": "slider",
      "defaultValue": 20,
      "min": 5,
      "max": 100,
      "step": 5
    },
    {
      "name": "exitScale",
      "label": "Exit Scale Reduction",
      "type": "slider",
      "defaultValue": 0.80,
      "min": 0.30,
      "max": 1.0,
      "step": 0.05
    },
    {
      "name": "exitOpacity",
      "label": "Exit Opacity Fade",
      "type": "slider",
      "defaultValue": 1.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.05
    },
    {
      "name": "borderRadius",
      "label": "Corner Radius",
      "type": "slider",
      "defaultValue": 20,
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px"
    },
    {
      "name": "perspective",
      "label": "3D Perspective Depth",
      "type": "slider",
      "defaultValue": 1200,
      "min": 300,
      "max": 2500,
      "step": 50,
      "unit": "px"
    }
  ]
}
