{
  "name": "apparatus-turbulence-lens",
  "displayName": "Apparatus Turbulence Lens",
  "description": "Organic SVG feTurbulence + feDisplacementMap fluid distortion lens reacting to cursor proximity and scroll velocity over editorial compositions.",
  "category": "svg",
  "tags": [
    "SVG",
    "Filter",
    "GSAP",
    "Turbulence",
    "Cursor",
    "Scroll",
    "Physics"
  ],
  "author": "vessel",
  "controls": [
    {
      "name": "layoutMode",
      "label": "Layout Composition",
      "type": "select",
      "defaultValue": "split",
      "options": ["split", "overlay", "full-bleed"]
    },
    {
      "name": "ambientDisplacement",
      "label": "Ambient Displacement",
      "type": "slider",
      "defaultValue": 5,
      "min": 0,
      "max": 10,
      "step": 0.5,
      "unit": "px"
    },
    {
      "name": "lensDisplacement",
      "label": "Lens Displacement",
      "type": "slider",
      "defaultValue": 25,
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px"
    },
    {
      "name": "lensRadius",
      "label": "Lens Radius",
      "type": "slider",
      "defaultValue": 160,
      "min": 50,
      "max": 300,
      "step": 10,
      "unit": "px"
    },
    {
      "name": "noiseFrequency",
      "label": "Noise Frequency",
      "type": "slider",
      "defaultValue": 0.012,
      "min": 0.005,
      "max": 0.05,
      "step": 0.001,
      "unit": ""
    },
    {
      "name": "noiseOctaves",
      "label": "Noise Octaves",
      "type": "slider",
      "defaultValue": 3,
      "min": 1,
      "max": 5,
      "step": 1,
      "unit": ""
    },
    {
      "name": "lensFollowSpeed",
      "label": "Lens Lag Duration",
      "type": "slider",
      "defaultValue": 0.3,
      "min": 0.1,
      "max": 1.0,
      "step": 0.05,
      "unit": "s"
    },
    {
      "name": "scrollVelocityEffect",
      "label": "Scroll Velocity Scale",
      "type": "slider",
      "defaultValue": 0.5,
      "min": 0,
      "max": 2.0,
      "step": 0.1,
      "unit": "x"
    },
    {
      "name": "enableCursorLens",
      "label": "Enable Cursor Lens",
      "type": "toggle",
      "defaultValue": true
    }
  ]
}
